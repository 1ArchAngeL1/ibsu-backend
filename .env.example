# Copy to backend/.env and fill in. Nothing here has a safe default.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/ibsu

# At least 32 characters. `openssl rand -base64 48`
JWT_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# The website. CORS_ORIGINS is a comma-separated list.
SITE_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate

# Shared with the website. It rejects revalidation calls without it.
# `openssl rand -hex 32`
REVALIDATE_SECRET=

# Lets the website read unpublished drafts for preview. Never sent to a browser.
# `openssl rand -hex 32`
PREVIEW_SECRET=

# Uploads land here; the API serves them at /media/...
UPLOADS_DIR=uploads
UPLOAD_MAX_BYTES=26214400
VARIANT_WIDTHS=480,768,1200,1920

# The website's public/ folder, indexed into the media library.
# The website is a sibling directory.
SITE_PUBLIC_DIR=../ibsu/public
