{
  "name": "ibsu-cms",
  "version": "0.1.0",
  "private": true,
  "description": "The IBSU content backend: the API the website reads from, and the admin API it is edited through.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,tools}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/tsconfig.json",
    "extract": "cd ../ibsu && ../ibsu-backend/node_modules/.bin/tsx --tsconfig tsconfig.json ../ibsu-backend/tools/extract-legacy-content.ts",
    "seed": "tsx tools/seed.ts",
    "create-admin": "tsx tools/create-admin.ts",
    "infer": "tsx tools/infer-content-model.ts",
    "mongo": "mongod --dbpath ./.mongo-data",
    "seed-categories": "tsx tools/seed-categories.ts",
    "migrate-posts": "tsx tools/migrate-records-to-posts.ts",
    "import-posts": "tsx tools/import-posts.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
